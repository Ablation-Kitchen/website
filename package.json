{
  "name": "ablation-kitchen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ablation.kitchen: Dalmo Veras's personal site",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:csp": "playwright test csp",
    "test:a11y": "playwright test a11y",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun && node scripts/lhci-check-urls.ts",
    "test:links": "scripts/check-links.sh internal",
    "lint:prose": "node scripts/vale-rules.ts && vale src/content"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "astro-expressive-code": "^0.44.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "1.65.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "mdast-util-mdx-expression": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.1",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
