---
/**
 * The fork-toque mark: a chef's hat whose crown is five fork tines, the middle
 * tine in accent. 2px square-cap strokes. Decorative: the wordmark beside it
 * names the link.
 */
import { FORK_TOQUE } from '../art/shapes';

interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={FORK_TOQUE.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <Fragment set:html={FORK_TOQUE.body} />
</svg>
