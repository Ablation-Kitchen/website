---
/**
 * Faint faceted planes tucked into a panel corner (homepage Lab panel,
 * /research glance panel, the case-study glance panel).
 *
 * Absolutely positioned behind the panel's content (z-index −1): give the
 * parent `position: relative; isolation: isolate` and, for a rounded
 * panel, `overflow: hidden` so the planes follow its corner.
 */
import ArtFrame from './ArtFrame.astro';
import { LAB_PLANES, heightFor } from './shapes';
import type { ArtBehaviour } from './types';

type Corner = 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';

interface Props extends Omit<ArtBehaviour, 'tilt' | 'float' | 'rotate'> {
  corner?: Corner;
  /** Rendered width in px; height follows the 260×200 viewBox. */
  width?: number;
}

// Literal class strings (not built from parts) so Tailwind sees them. No inline
// styles: the CSP (#25) blocks them.
const CORNER: Record<Corner, string> = {
  'top-left': 'top-0 left-0',
  'top-right': 'top-0 right-0',
  'bottom-left': 'bottom-0 left-0',
  'bottom-right': 'bottom-0 right-0',
};

const { corner = 'bottom-right', width = 260, class: className, ...behaviour } = Astro.props;
const height = heightFor(LAB_PLANES, width);
const [v, h] = corner.split('-') as ['top' | 'bottom', 'left' | 'right'];
---

<ArtFrame
  {...behaviour}
  class:list={['pointer-events-none absolute -z-1 leading-[0]', CORNER[corner], className]}
>
  <svg
    class:list={['planes', { 'flip-x': h === 'left', 'flip-y': v === 'top' }]}
    width={width}
    height={height}
    viewBox={LAB_PLANES.viewBox}
    focusable="false"
  >
    <Fragment set:html={LAB_PLANES.body} />
  </svg>
</ArtFrame>

<style>
  /* Paint for the shapes.ts classes. The OG cards repeat these rules with the Light values (src/lib/og/art.ts). */
  .planes {
    display: block;
    scale: var(--flip-x, 1) var(--flip-y, 1);
  }

  .flip-x {
    --flip-x: -1;
  }

  .flip-y {
    --flip-y: -1;
  }

  .planes :global(.a) {
    fill: var(--color-plane-a, #c9a66b);
  }

  .planes :global(.b) {
    fill: var(--color-plane-b, #5b7c99);
  }

  .planes :global(.accent) {
    fill: var(--color-accent, #69908c);
  }

  .planes :global(.line) {
    fill: none;
    stroke: var(--color-ink, #111111);
    stroke-width: 0.8;
    stroke-opacity: 0.22;
  }
</style>
