---
/**
 * A bottle split down the middle into two offset planes, with a label band
 * that bridges the halves. Homepage + /about (above Kitchen rules).
 */
import ArtFrame from './ArtFrame.astro';
import { SPLIT_BOTTLE, heightFor } from './shapes';
import type { ArtBehaviour } from './types';

interface Props extends ArtBehaviour {
  /** Rendered width in px; height follows the 96×116 viewBox. */
  width?: number;
}

const { width = 96, tilt = true, ...behaviour } = Astro.props;
const height = heightFor(SPLIT_BOTTLE, width);
---

<ArtFrame tilt={tilt} {...behaviour}>
  <svg
    class="bottle"
    width={width}
    height={height}
    viewBox={SPLIT_BOTTLE.viewBox}
    focusable="false"
  >
    <Fragment set:html={SPLIT_BOTTLE.body} />
  </svg>
</ArtFrame>

<style>
  /* Paint for the shapes.ts classes. The OG cards repeat these rules with the Light values (src/lib/og/art.ts). */
  .bottle {
    display: block;
    overflow: visible;
  }

  .bottle :global(.ink) {
    stroke: var(--color-ink, #111111);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .bottle :global(.a) {
    fill: var(--color-plane-a, #c9a66b);
  }

  .bottle :global(.b) {
    fill: var(--color-plane-b, #5b7c99);
  }

  .bottle :global(.surface) {
    fill: var(--color-surface, #ffffff);
  }

  .bottle :global(.accent) {
    stroke: var(--color-accent, #69908c);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .bottle :global(.faint) {
    stroke: var(--color-meta, #6a6a66);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .bottle :global(.line) {
    fill: none;
    stroke: var(--color-ink, #111111);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
</style>
