---
/**
 * Shared wrapper for every decorative piece: the art and the chaos tickets.
 *
 * - Always `aria-hidden="true"`: pieces carry no content a reader needs.
 * - `hideOnSmall` (default on) hides the piece below 960px.
 * - `rotate` sets a resting rotation in degrees (one of `ROTATIONS`), kept in
 *   `--art-rot` so the float and the hover tilt both build on it (they use the
 *   individual `translate` / `rotate` / `scale` properties, so they never
 *   fight). It's set through `data-rot` and a stylesheet rule, never an inline
 *   `style` attribute, which the CSP (#25) blocks.
 * - `float`: an 8px drift over 6s. `tilt`: hover tilt of −2° and scale 1.02
 *   over 0.8s. Both only run when the reader allows motion.
 *
 * No client JS, no inline styles.
 */
import type { HTMLAttributes } from 'astro/types';
import type { ArtBehaviour } from './types';

type Props = ArtBehaviour &
  Omit<HTMLAttributes<'div'>, 'class' | 'style' | 'aria-hidden' | 'data-rot'> & {
    /** `span` (inline-block) for pieces placed inside phrasing content. */
    as?: 'div' | 'span';
  };

const {
  as: Tag = 'div',
  rotate = 0,
  float = false,
  tilt = false,
  hideOnSmall = true,
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  {...rest}
  aria-hidden="true"
  class:list={[
    'art',
    className,
    { inline: Tag === 'span', float, tilt, 'hide-small': hideOnSmall },
  ]}
  data-rot={rotate || undefined}
>
  <slot />
</Tag>

<style>
  .art {
    width: fit-content;
    max-width: 100%;
    rotate: var(--art-rot, 0deg);
  }

  /* One rule per value in ROTATIONS (types.ts). */
  [data-rot='-8'] {
    --art-rot: -8deg;
  }

  [data-rot='-6'] {
    --art-rot: -6deg;
  }

  [data-rot='-4'] {
    --art-rot: -4deg;
  }

  [data-rot='-3'] {
    --art-rot: -3deg;
  }

  [data-rot='-2'] {
    --art-rot: -2deg;
  }

  [data-rot='-1'] {
    --art-rot: -1deg;
  }

  [data-rot='1'] {
    --art-rot: 1deg;
  }

  [data-rot='2'] {
    --art-rot: 2deg;
  }

  [data-rot='3'] {
    --art-rot: 3deg;
  }

  [data-rot='4'] {
    --art-rot: 4deg;
  }

  [data-rot='6'] {
    --art-rot: 6deg;
  }

  [data-rot='8'] {
    --art-rot: 8deg;
  }

  .inline {
    display: inline-block;
    vertical-align: middle;
  }

  @media (max-width: 959.98px) {
    .hide-small {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: ak-art-float 6s ease-in-out infinite;
    }

    .tilt {
      transition:
        rotate 0.8s var(--ease-out, cubic-bezier(0.2, 0.7, 0.2, 1)),
        scale 0.8s var(--ease-out, cubic-bezier(0.2, 0.7, 0.2, 1));
    }

    .tilt:hover {
      rotate: calc(var(--art-rot, 0deg) - 2deg);
      scale: 1.02;
    }

    @keyframes ak-art-float {
      50% {
        translate: 0 -8px;
      }
    }
  }
</style>
