---
/**
 * Homepage hero art: an original cubist kitchen still life. A cup seen from
 * the side and from above at once, a fork broken into offset pieces, a knife
 * whose blade and handle don't line up, and a half-lemon in the accent, on
 * flat overlapping ochre/slate planes with bold ink outlines.
 */
import ArtFrame from './ArtFrame.astro';
import { STILL_LIFE, heightFor } from './shapes';
import type { ArtBehaviour } from './types';

interface Props extends ArtBehaviour {
  /** Rendered width in px; height follows the 400×420 viewBox. */
  width?: number;
}

const { width = 360, tilt = true, ...behaviour } = Astro.props;
const height = heightFor(STILL_LIFE, width);
---

<ArtFrame tilt={tilt} {...behaviour}>
  <svg class="still" width={width} height={height} viewBox={STILL_LIFE.viewBox} focusable="false">
    <Fragment set:html={STILL_LIFE.body} />
  </svg>
</ArtFrame>

<style>
  /* Paint for the shapes.ts classes. The OG cards repeat these rules with the Light values (src/lib/og/art.ts). */
  .still {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .still :global(.ink) {
    stroke: var(--color-ink, #111111);
    stroke-width: 2.4;
    stroke-linejoin: round;
  }

  .still :global(.ink-line) {
    fill: none;
    stroke: var(--color-ink, #111111);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .still :global(.ink-none) {
    fill: none;
  }

  .still :global(.ink-fill) {
    fill: var(--color-ink, #111111);
  }

  .still :global(.surface) {
    fill: var(--color-surface, #ffffff);
  }

  .still :global(.plane-a),
  .still :global(.plane-a-solid) {
    fill: var(--color-plane-a, #c9a66b);
  }

  .still :global(.plane-b),
  .still :global(.plane-b-solid) {
    fill: var(--color-plane-b, #5b7c99);
  }

  .still :global(.accent-fill) {
    fill: var(--color-accent, #69908c);
  }

  .still :global(.flesh) {
    fill: color-mix(in srgb, var(--color-accent, #69908c) 35%, var(--color-surface, #ffffff));
  }

  .still :global(.segments line) {
    stroke: var(--color-accent, #69908c);
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>
