---
/**
 * "What's cooking" on the homepage (spec: IA → Homepage section order;
 * Interactions → Ticket rail, Trace replay; #6, #10, #37). Rendered only once
 * a project has a committed real trace (see `homepageSections`), so at launch
 * it is absent. One card per project with a trace; the replay shows the
 * selected project's latest run.
 */
import type { CollectionEntry } from 'astro:content';
import type { RailProject } from '../../lib/visibility';
import { STATUS_LABEL, toReplay } from '../../lib/trace-view';
import TicketRail from '../trace/TicketRail.astro';

interface Props {
  rail: RailProject<CollectionEntry<'projects'>, CollectionEntry<'traces'>>[];
}

const { rail } = Astro.props;
const cards = rail.map(({ project }) => ({
  project: project.id,
  ticket: project.data.ticket,
  name: project.data.name,
  status: STATUS_LABEL[project.data.status],
}));
const replays = Object.fromEntries(
  rail.map(({ project, latestTrace }) => [project.id, toReplay(latestTrace.data)]),
);
---

<section aria-labelledby="whats-cooking-h" class="border-y border-rule bg-surface">
  <div class="wrap py-26">
    <p class="font-mono text-label text-meta">On the rail</p>
    <h2
      id="whats-cooking-h"
      class="mt-3.5 text-[clamp(40px,2.5rem+1vw,52px)] leading-none tracking-[-0.02em]"
    >
      What's cooking
    </h2>
    <p class="mt-4 max-w-[620px] font-light">
      Current projects, each with the latest recorded run of its brigade. Pick a ticket to replay
      its run step by step.
    </p>
    <TicketRail cards={cards} replays={replays} />
  </div>
</section>
