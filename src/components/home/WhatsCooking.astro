---
/**
 * "What's cooking" on the homepage (spec: IA → Homepage section order; #6,
 * #10). Rendered only once a project has a committed real trace (see
 * `homepageSections`), so at launch it is absent.
 *
 * TODO(#37): replace the static list with the ticket rail (one pressable
 * card per project) and the trace replay of the selected project's latest
 * run. Until then this lists the rail projects as server-rendered text, so
 * the section is wired to the same data and never shows a placeholder.
 */
import type { CollectionEntry } from 'astro:content';
import type { RailProject } from '../../lib/visibility';

interface Props {
  rail: RailProject<CollectionEntry<'projects'>, CollectionEntry<'traces'>>[];
}

const { rail } = Astro.props;
---

<section aria-labelledby="whats-cooking-h" class="border-y border-rule bg-surface">
  <div class="wrap py-26">
    <p class="font-mono text-label text-meta">On the rail</p>
    <h2
      id="whats-cooking-h"
      class="mt-3.5 text-[clamp(40px,2.5rem+1vw,52px)] leading-none tracking-[-0.02em]"
    >
      What's cooking
    </h2>
    <ul class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
      {rail.map(({ project, latestTrace }) => (
        <li class="rounded-[14px] border border-rule bg-bg p-6">
          <span class="font-mono text-label-sm text-meta">Ticket {project.data.ticket}</span>
          <span class="mt-7 mb-2 block font-serif text-[30px] leading-[1.05] text-ink">
            {project.data.name}
          </span>
          <span class="block text-ui text-meta">Latest run: {latestTrace.data.title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
