---
/**
 * The Ablation Lab panel (spec: Content → Research; #6, #7). The framing, the
 * ablation graphic and "Enter the lab" always show. Tags come from
 * `labTags()`: at launch only the PhD tag. The *Too many cooks?* sentence
 * appears only once there is a linked preprint to point at.
 */
import AblationGraphic from '../art/AblationGraphic.astro';
import LabPlanes from '../art/LabPlanes.astro';
import type { LabTag } from '../../lib/visibility';

interface Props {
  tags: LabTag[];
  /** The linked preprint for *Too many cooks?*, when there is one. */
  preprintHref?: string | undefined;
}

const { tags, preprintHref } = Astro.props;
---

<section id="lab" aria-labelledby="lab-h" class="wrap pt-16 pb-26 lg:pb-34">
  <div class="relative isolate flex flex-wrap items-center justify-between gap-12 overflow-hidden rounded-[20px] border border-rule bg-surface p-7 sm:p-16">
    <LabPlanes corner="bottom-right" />
    <div class="max-w-[560px] flex-[1_1_420px]">
      <p class="font-mono text-label text-meta">The Ablation Lab · research</p>
      <h2
        id="lab-h"
        class="mt-3.5 text-[clamp(40px,2.5rem+1vw,52px)] leading-[1.02] tracking-[-0.02em]"
      >
        Take one ingredient out. <em class="text-accent-text">Taste the difference.</em>
      </h2>
      <p class="mt-4.5 font-light">
        Experiments that remove one part of an agent system at a time, to measure what each part is
        really worth.
        {preprintHref && (
          <>
            {' '}
            First study:{' '}
            <a href={preprintHref} class="text-accent-text underline underline-offset-4">
              <em>Too many cooks?</em>
            </a>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Research">
          {tags.map((t) => (
            <li class="flex">
              {t.href ? (
                <a
                  href={t.href}
                  class="inline-flex min-h-11 items-center rounded-full border border-rule px-3 font-mono text-label-sm text-accent-text hover:border-current"
                >
                  {t.label}
                </a>
              ) : (
                <span class="rounded-full border border-rule px-3 py-1.5 font-mono text-label-sm text-meta">
                  {t.label}
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
      <a
        href="/research"
        class="mt-8 inline-flex min-h-12 items-center gap-2.5 rounded-full bg-ink px-6.5 text-[15px] font-medium text-bg"
      >
        Enter the lab <span aria-hidden="true">→</span>
      </a>
    </div>
    <AblationGraphic class="flex-[0_1_300px]" />
  </div>
</section>
