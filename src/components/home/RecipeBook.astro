---
/**
 * "From the recipe book" on the homepage: two featured posts as cards
 * (spec: IA → Homepage section order). Rendered only once a non-draft post
 * exists (see `homepageSections`, #6, #44).
 */
import type { CollectionEntry } from 'astro:content';
import { postPath } from '../../lib/urls';
import { isoDay, KIND_LABEL, postDate } from '../../lib/writing';

interface Props {
  posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

<section id="recipe-book" aria-labelledby="recipe-book-h" class="wrap py-16">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
    <div class="pt-2 pr-2 pb-6">
      <p class="font-mono text-label text-meta">Recipes · writing</p>
      <h2
        id="recipe-book-h"
        class="mt-3.5 text-[clamp(40px,2.5rem+1vw,52px)] leading-none tracking-[-0.02em]"
      >
        From the recipe book
      </h2>
    </div>
    {posts.map((p) => (
      <a
        href={postPath(p.id)}
        class="card flex flex-col justify-between gap-10 rounded-[14px] border border-rule bg-surface p-8"
      >
        <span class="font-mono text-label-sm text-meta">
          {KIND_LABEL[p.data.kind]} ·{' '}
          <time datetime={isoDay(p.data.date)}>{postDate(p.data.date)}</time>
        </span>
        <span class="font-serif text-[28px] leading-[1.15] text-ink">{p.data.title}</span>
      </a>
    ))}
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        translate 0.45s var(--ease-kitchen),
        box-shadow 0.45s var(--ease-kitchen),
        border-color 0.3s;
    }

    .card:hover {
      translate: 0 -4px;
      box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
    }
  }
</style>
