---
/**
 * Kitchen rules on the homepage (spec: Content → About): the story, the PhD
 * and education beside the five numbered kitchen rules (an `<ol>`), with the
 * split bottle above the heading (decorative, hidden below 960px).
 */
import SplitBottle from '../art/SplitBottle.astro';
import { education, kitchenRules, story } from '../../data/about';
---

<section id="kitchen-rules" aria-labelledby="kitchen-rules-h" class="border-t border-rule">
  <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-18 py-26 lg:py-34">
    <div>
      <p class="font-mono text-label text-meta">Meet the chef · about + CV</p>
      <SplitBottle class="mt-2 mb-5" />
      <h2 id="kitchen-rules-h" class="mt-3.5 text-h2">
        Kitchen rules
      </h2>
      <p class="mt-6 max-w-[440px] font-light">{story[0]}</p>
      <p class="mt-5 max-w-[440px] font-light">{story[1]}</p>
      <ul class="mt-7 flex flex-col gap-2 font-mono text-label text-meta" aria-label="Education">
        {education.map((e) => (
          <li>{`${e.degree} · ${e.school} · ${e.years}`}</li>
        ))}
      </ul>
    </div>
    <ol class="self-start">
      {kitchenRules.map((r) => (
        <li class="grid grid-cols-[44px_minmax(0,1fr)] gap-3 border-b border-rule py-5.5">
          <span class="pt-1.5 font-mono text-label-sm text-accent-text" aria-hidden="true">
            {r.n}
          </span>
          <span>
            <span class="block font-serif text-[26px] leading-[1.2] text-ink">{r.rule}</span>
            <span class="block text-[15px] text-meta">{r.meaning}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
