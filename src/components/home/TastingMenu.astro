---
/**
 * The tasting menu on the homepage: one row per non-draft case study, in
 * course order, each linking to its case-study page. The numeral comes from
 * `visibleCourses()` (#6), never from the content file. Only rendered when
 * there is at least one course (see `homepageSections`).
 */
import type { CollectionEntry } from 'astro:content';
import type { Course } from '../../lib/visibility';
import { coursePath } from '../../lib/urls';
import { TASTING_MENU_LEDE } from '../../lib/work';

interface Props {
  courses: Course<CollectionEntry<'work'>>[];
}

const { courses } = Astro.props;
---

<section id="tasting-menu" aria-labelledby="tasting-menu-h" class="wrap pt-26 pb-16 lg:pt-34">
  <p class="font-mono text-label text-meta">Signature dishes · case studies</p>
  <h2 id="tasting-menu-h" class="mt-3.5 text-h2">
    The tasting menu
  </h2>
  <p class="mt-4 max-w-[620px] font-light">{TASTING_MENU_LEDE}</p>

  <ol class="mt-12 border-t border-rule">
    {courses.map((c) => (
      <li class="border-b border-rule">
        <a
          href={coursePath(c.id)}
          class="row grid grid-cols-[48px_minmax(0,1fr)] items-baseline gap-x-4 gap-y-3 py-9 sm:grid-cols-[64px_minmax(0,1fr)_auto] sm:items-center sm:gap-x-6"
        >
          <span class="font-serif text-[22px] text-meta italic">
            <span class="sr-only">Course </span>
            {c.numeral}
          </span>
          <span class="flex flex-col gap-1.5">
            <span class="font-serif text-title text-ink">{c.data.title}</span>
            <span class="max-w-[620px] text-base font-light">{c.data.summary}</span>
          </span>
          <span class="col-start-2 flex items-center gap-4 font-mono text-label-sm text-meta sm:col-start-auto">
            {c.data.org} · {c.data.years}
            <span class="arrow text-xl text-ink" aria-hidden="true">
              →
            </span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .arrow {
    display: inline-block;
    font-family: var(--font-sans);
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: translate 0.35s var(--ease-kitchen);
    }
  }

  .row:hover .arrow,
  .row:focus-visible .arrow {
    translate: 6px 0;
  }
</style>
