---
/**
 * Goes in <head>, before the stylesheets. Sets `data-theme` on <html> before
 * first paint, from a saved preference or the OS. The inline script is static
 * (no interpolation) so the CSP (#25) can hash it: editing it changes the hash.
 * The metas come first so the script can collapse them to one tag when a
 * preference is saved.
 */
import { DARK_QUERY, LIGHT_QUERY, THEME_COLOR } from './theme';
---

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media={LIGHT_QUERY} content={THEME_COLOR.light} />
<meta name="theme-color" media={DARK_QUERY} content={THEME_COLOR.dark} />
<script is:inline>
  (function () {
    const d = document.documentElement;
    let t = null;
    try {
      t = localStorage.getItem('theme');
    } catch {
      // Storage blocked (private mode, sandboxed iframe): fall back to the OS preference.
    }
    const saved = t === 'light' || t === 'dark';
    if (!saved) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    d.setAttribute('data-theme', t);
    if (saved) {
      for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
        if ((m.getAttribute('media') || '').includes(t)) m.removeAttribute('media');
        else m.remove();
      }
    }
  })();
</script>
