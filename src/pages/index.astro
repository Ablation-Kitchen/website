---
/**
 * The Pass: the homepage (#33). Sections and their order come from
 * `homepageSections()`; each conditional section reads its content through
 * the visibility helpers (#6), so nothing here is toggled by hand.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WhatsCooking from '../components/home/WhatsCooking.astro';
import TastingMenu from '../components/home/TastingMenu.astro';
import RecipeBook from '../components/home/RecipeBook.astro';
import LabPanel from '../components/home/LabPanel.astro';
import KitchenRules from '../components/home/KitchenRules.astro';
import { dishesHref, featuredPosts, homepageSections } from '../lib/homepage';
import { linkedPreprintHref } from '../lib/research';
import { getCourses, getLab, getPosts, getRail, getResearch } from '../lib/visibility';

const [rail, courses, posts, lab, research] = await Promise.all([
  getRail(),
  getCourses(),
  getPosts(),
  getLab(),
  getResearch(),
]);

const sections = homepageSections({ rail, courses, posts });

const preprintHref = linkedPreprintHref(research);
---

<BaseLayout description="Dalmo Veras, Lead AI Engineer: agent platforms, retrieval systems and applied ML in production. Case studies, research and writing.">
  {sections.map((s) => {
    switch (s) {
      case 'hero':
        return <Hero dishesHref={dishesHref(sections)} />;
      case 'whats-cooking':
        return <WhatsCooking rail={rail} />;
      case 'tasting-menu':
        return <TastingMenu courses={courses} />;
      case 'recipe-book':
        return <RecipeBook posts={featuredPosts(posts)} />;
      case 'lab':
        return <LabPanel tags={lab.tags} preprintHref={preprintHref} />;
      case 'kitchen-rules':
        return <KitchenRules />;
    }
  })}
</BaseLayout>
