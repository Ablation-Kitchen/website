---
/**
 * The layout shell every page uses: <head> (title pattern, description,
 * canonical, OG/Twitter tags, Person JSON-LD, sitemap), skip link, sticky
 * header, <main id="main"> and the footer.
 *
 * Inline scripts: only ThemeHead's static theme script (hashed by the CSP,
 * #25) and the JSON-LD data block, which is not executable and so not subject
 * to script-src. Everything else is an external module.
 */
import ThemeHead from '../components/theme/ThemeHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { absoluteUrl, canonicalUrl, pageTitle, personJsonLd, serializeJsonLd } from '../lib/seo';
import { getHasWriting } from '../lib/visibility';
import { FEED_TITLE } from '../lib/feed';
import '../styles/global.css';
// Preloaded so text renders in its own font on first paint: a late swap shifts
// centred layouts (CLS over the 0.02 budget on the 404 in Lighthouse CI, #28).
// Same files as the @fontsource CSS, so Vite emits each once.
import instrumentSerif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import interTight300 from '@fontsource/inter-tight/files/inter-tight-latin-300-normal.woff2?url';
import interTight400 from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';
import interTight500 from '@fontsource/inter-tight/files/inter-tight-latin-500-normal.woff2?url';
import jetbrainsMono400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

const PRELOAD_FONTS = [
  instrumentSerif400,
  interTight300,
  interTight400,
  interTight500,
  jetbrainsMono400,
];

export interface OgImage {
  /** Path on the site (e.g. `/og/work.png`) or absolute URL. */
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

export interface Props {
  /** Page name for "<Page> · Dalmo Veras". Omit on the homepage. */
  title?: string;
  /** Meta description; every page needs one (spec: Deployment → SEO). */
  description: string;
  /** OG image (1200×630). Generated per page by #39; omitted until then. */
  image?: OgImage;
  /** `article` for case studies and posts. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search (e.g. dev-only pages). */
  noindex?: boolean;
}

const { title, description, image, ogType = 'website', noindex = false } = Astro.props;

// /rss.xml only exists once a post is visible (#40), so the alternate link follows the same gate.
const hasFeed = await getHasWriting();
const fullTitle = pageTitle(title);
const canonical = canonicalUrl(Astro.url.pathname);
const og = image && {
  url: absoluteUrl(image.src),
  alt: image.alt,
  width: image.width ?? 1200,
  height: image.height ?? 630,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    {PRELOAD_FONTS.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Without it the browser asks for /favicon.ico, whose 404 fails Lighthouse Best Practices (#28). */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {hasFeed && (
      <link rel="alternate" type="application/rss+xml" title={FEED_TITLE} href="/rss.xml" />
    )}
    <meta name="author" content="Dalmo Veras" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ablation.kitchen" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && (
      <>
        <meta property="og:image" content={og.url} />
        <meta property="og:image:alt" content={og.alt} />
        <meta property="og:image:width" content={String(og.width)} />
        <meta property="og:image:height" content={String(og.height)} />
      </>
    )}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {og && (
      <>
        <meta name="twitter:image" content={og.url} />
        <meta name="twitter:image:alt" content={og.alt} />
      </>
    )}

    <script is:inline type="application/ld+json" set:html={serializeJsonLd(personJsonLd())} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="fixed top-3 left-4 z-50 inline-flex min-h-11 -translate-y-24 items-center rounded-full bg-ink px-5 text-ui font-medium text-bg focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
